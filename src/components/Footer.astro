---
import { business, contact, nav, footer, portfolio, whatsappLink } from '../content/site';
import Logo from './Logo.astro';
import Edge from './Edge.astro';
---
<footer class="on-dark relative z-[6] bg-charcoal-900 text-linen-200">
  <Edge fill="var(--color-charcoal-900)" fringe />
  <div class="mx-auto grid max-w-[96rem] grid-cols-2 gap-x-6 gap-y-10 px-gutter pt-20 pb-10 lg:grid-cols-12">
    <div class="col-span-2 lg:col-span-5">
      <span class="text-linen-50"><Logo size={34} /></span>
      <p class="mt-5 max-w-[38ch] text-base">{footer.line}</p>
      <p class="mt-6 font-display text-2xl font-light text-linen-50 italic">{footer.closing}</p>
    </div>

    <div class="lg:col-span-2 lg:col-start-7">
      <p class="tag text-madder-300">Pages</p>
      <ul class="mt-3">
        {nav.map((n) => <li><a href={n.href} class="link-thread text-linen-100">{n.label}</a></li>)}
      </ul>
    </div>

    <div class="lg:col-span-2">
      <p class="tag text-madder-300">Talk to us</p>
      <ul class="mt-3">
        <li><a href={whatsappLink(contact.whatsappGreeting)} class="link-thread text-linen-100" target="_blank" rel="noopener">WhatsApp</a></li>
        <li><a href={`tel:${contact.phoneHref}`} class="link-thread text-linen-100">{contact.phoneDisplay}</a></li>
        <li><a href={`mailto:${contact.email}`} class="link-thread text-linen-100 break-all">{contact.email}</a></li>
      </ul>
    </div>

    <div class="col-span-2 sm:col-span-1 lg:col-span-2">
      <p class="tag text-madder-300">Studio</p>
      <address class="mt-3 text-sm not-italic">
        {contact.address.map((l) => <span class="block">{l}</span>)}
      </address>
      <ul class="mt-3 text-sm">
        {contact.hours.map((h) => <li>{h.days}: {h.time}</li>)}
      </ul>
    </div>

    <div class="col-span-2 flex flex-col gap-3 border-t border-dashed border-charcoal-500 pt-6 text-sm sm:flex-row sm:items-center sm:justify-between lg:col-span-12">
      <p>© {new Date().getFullYear()} {business.name}. {business.city}, {business.country}.</p>
      <p class="text-linen-300">
        {portfolio.note} <a href={portfolio.studioUrl} class="font-semibold text-linen-50 underline decoration-madder-500 decoration-2 underline-offset-4" target="_blank" rel="noopener">{portfolio.studio}</a>. {portfolio.noteEnd}
      </p>
    </div>
  </div>
</footer>
