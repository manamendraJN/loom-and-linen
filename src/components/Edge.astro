---
/**
 * The top edge of a section: a soft woven selvedge with a running stitch
 * just inside it. The thread stitches each section to the one before.
 * `fill` is the section's background token; `stitch` the thread colour.
 * `fringe` turns the edge into the fringed end of a sarong (footer).
 */
interface Props { fill: string; stitch?: string; fringe?: boolean }
const { fill, stitch = 'var(--color-madder-500)', fringe = false } = Astro.props;
const tassels = Array.from({ length: 120 }, (_, i) => i * 12 + 6);
---
<div class="edge" aria-hidden="true">
  {fringe ? (
    <svg viewBox="0 0 1440 28" preserveAspectRatio="none">
      {tassels.map((x, i) => (
        <path d={`M${x},28 C${x + 1},${20 - (i % 3)} ${x - 1},${14} ${x + (i % 2 ? 1 : -1)},${8 + (i % 4)}`} stroke={fill} stroke-width="3" vector-effect="non-scaling-stroke" fill="none" stroke-linecap="round" />
      ))}
    </svg>
  ) : (
    <svg viewBox="0 0 1440 28" preserveAspectRatio="none">
      <path d="M0,28 L0,13 C80,10 150,16 240,12 C340,8 420,15 520,13 C640,10 720,6 820,11 C930,16 1010,12 1110,9 C1220,6 1300,13 1380,12 L1440,11 L1440,28 Z" fill={fill} />
    </svg>
  )}
  <div class="stitch" data-stitch>
    <div class="stitch-inner" data-stitch-inner>
      <svg viewBox="0 0 1440 10" preserveAspectRatio="none">
        <path d="M0,5 C200,3 420,7 720,5 C1000,3 1220,7 1440,5" fill="none" stroke={stitch} stroke-width="1.8" stroke-dasharray="9 7" vector-effect="non-scaling-stroke" />
      </svg>
    </div>
  </div>
</div>

<style>
  .stitch {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 0.35rem);
    height: 10px;
    overflow: hidden;
  }
  .stitch-inner { position: absolute; inset: 0; }
  .stitch svg { display: block; width: 100%; height: 100%; }
</style>
