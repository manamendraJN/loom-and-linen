---
/** Floating garment-tag header plus a full-screen menu (Escape closes). */
import { nav, contact, whatsappLink } from '../content/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header" transition:name="site-header" transition:animate="none">
  <a href="/" class="hdr-pill hdr-logo" aria-label="Loom & Linen, home">
    <Logo />
  </a>
  <nav class="flex items-center gap-1.5" aria-label="Quick links">
    <a href="/shop" class:list={['hdr-pill hdr-shop px-4 font-semibold', { 'hdr-on': isActive('/shop') }]}>Shop</a>
    <a href="/order" class="btn btn-primary hdr-btn">Order</a>
    <button type="button" class="hdr-pill hdr-menu px-4 font-semibold" aria-label="Menu" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span>Menu</span>
      <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true"><path d="M1,2 C6,0.5 12,3.5 17,2 M1,10 C6,8.5 12,11.5 17,10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
    </button>
  </nav>
</header>

<div id="site-menu" class="menu on-dark" data-menu hidden>
  <div class="menu-inner" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="flex items-center justify-between px-gutter" style="height: var(--spacing-header)">
      <span class="text-linen-50"><Logo /></span>
      <button type="button" class="hdr-pill px-4 font-semibold" data-menu-close>Close <span aria-hidden="true">✕</span></button>
    </div>
    <div class="grid flex-1 grid-cols-1 gap-10 overflow-y-auto px-gutter pt-6 pb-10 lg:grid-cols-12" data-lenis-prevent>
      <ol class="lg:col-span-7">
        {nav.map((n, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a href={n.href} class="menu-link" aria-current={isActive(n.href) ? 'page' : undefined}>
              <span class="tag text-madder-300">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-3xl font-light">{n.label}</span>
              <span class="hidden text-sm text-linen-300 sm:inline">{n.note}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="menu-item flex flex-col gap-4 lg:col-span-4 lg:col-start-9 lg:self-end" style="--i:6">
        <p class="tag text-linen-300">Quickest way to reach us</p>
        <a href={whatsappLink(contact.whatsappGreeting)} class="btn btn-primary self-start" target="_blank" rel="noopener">WhatsApp {contact.whatsappDisplay}</a>
        <a href={`mailto:${contact.email}`} class="link-thread self-start text-linen-100">{contact.email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--spacing-header);
    padding: 0 var(--spacing-gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .site-header > * { pointer-events: auto; }
  .hdr-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: var(--spacing-tap);
    border-radius: var(--radius-xs);
    background: color-mix(in srgb, var(--color-linen-50) 88%, transparent);
    color: var(--color-charcoal-900);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 0 0 1px rgb(32 30 27 / 0.06);
    text-decoration: none;
  }
  .hdr-logo { padding: 0 0.85rem 0 0.7rem; }
  /* Phones: a live backdrop blur under three pills is re-run on every scroll
     frame; a near-solid fill looks the same and costs nothing. */
  @media (pointer: coarse), (max-width: 767px) {
    .hdr-pill { backdrop-filter: none; -webkit-backdrop-filter: none; background: color-mix(in srgb, var(--color-linen-50) 96%, transparent); }
  }
  .hdr-shop { display: none; }
  @media (min-width: 640px) { .hdr-shop { display: inline-flex; } }
  .hdr-on { box-shadow: inset 0 -2px 0 var(--color-madder-500); }
  .hdr-btn { padding-inline: 1.1rem; }
  @media (max-width: 440px) {
    .hdr-logo { padding: 0 0.7rem 0 0.6rem; }
    .hdr-logo :global(.font-display) { font-size: 1.12rem; }
    .hdr-menu { padding-inline: 0.85rem; }
    .hdr-menu span { display: none; }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 70;
    visibility: hidden;
    pointer-events: none;
  }
  .menu[data-open] { visibility: visible; pointer-events: auto; }
  .menu-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--color-indigo-900);
    color: var(--color-linen-100);
    transform: translateY(-100%);
    transition: transform 0.6s var(--ease-thread);
  }
  .menu[data-open] .menu-inner { transform: translateY(0); }
  .menu-item {
    opacity: 0;
    transform: translateY(1.2rem);
    transition: opacity 0.4s, transform 0.5s var(--ease-settle);
    transition-delay: calc(0.18s + var(--i) * 0.04s);
    list-style: none;
  }
  .menu[data-open] .menu-item { opacity: 1; transform: none; }
  .menu-link {
    display: grid;
    grid-template-columns: 2.5rem auto 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    min-height: var(--spacing-tap);
    border-bottom: 1px dashed rgb(240 233 221 / 0.18);
    text-decoration: none;
  }
  .menu-link:hover .font-display, .menu-link[aria-current='page'] .font-display { color: var(--color-turmeric-300); }
  .menu-link > :last-child { justify-self: end; }
</style>
