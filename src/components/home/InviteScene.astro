---
/** Scene 6: the invitation. The thread wraps the parcel and ties a knot. */
import { home, whatsappLink, orderMessage } from '../../content/site';
import Edge from '../Edge.astro';

const { invite } = home;
const words = invite.headline.split(' ');
const defaultWa = whatsappLink(orderMessage({ name: 'a piece from the collection (please help me choose)' }));
---
<section id="invite" class="scene on-dark relative z-[5] bg-indigo-900 text-linen-100" data-scene aria-labelledby="invite-title">
  <Edge fill="var(--color-indigo-900)" />
  <div class="mx-auto grid max-w-[96rem] grid-cols-1 items-center gap-10 px-gutter pt-section pb-[calc(var(--spacing-section)*0.8)] lg:grid-cols-12">
    <div class="relative z-[2] lg:col-span-6 lg:row-start-1">
      <h2 id="invite-title" class="text-5xl font-light" aria-label={invite.headline}>
        {words.map((w, i) => <>{i > 0 && ' '}<span class="rw" aria-hidden="true"><span class="rwi" data-rword>{w}</span></span></>)}
      </h2>
      <p class="mt-6 max-w-[36ch] text-lg text-linen-200" data-reveal>{invite.line}</p>

      <div class="choice mt-8" data-reveal data-choice>
        <p class="tag text-madder-300">{invite.choiceLabel}</p>
        <p class="mt-1 font-display text-xl" data-choice-text>{invite.noChoice}</p>
        <a href="#collection" class="link-thread text-sm text-linen-200" data-choice-change>Change</a>
      </div>

      <div class="mt-6 flex flex-wrap gap-3" data-reveal>
        <a href={invite.shop.href} class="btn btn-light">{invite.shop.label}</a>
        <a href={defaultWa} class="btn btn-primary" data-wa-choice target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
          {invite.whatsapp}
        </a>
      </div>
    </div>

    <div class="parcel-wrap lg:col-span-6 lg:row-start-1" data-parcel>
      <svg viewBox="0 0 520 420" class="h-auto w-full overflow-visible" role="img" aria-label="Illustration: a folded piece of cloth tied with red thread, ready to send">
        <defs>
          <linearGradient id="parcel-light" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--color-sun)" stop-opacity="0.35" />
            <stop offset="0.5" stop-color="var(--color-sun)" stop-opacity="0" />
            <stop offset="1" stop-color="var(--color-charcoal-950)" stop-opacity="0.3" />
          </linearGradient>
          <filter id="parcel-shadow" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="14" /></filter>
        </defs>
        <ellipse cx="262" cy="352" rx="210" ry="26" fill="var(--color-charcoal-950)" opacity="0.45" filter="url(#parcel-shadow)" />
        <!-- folded cloth: layers of the striped shirt peek out at the edge -->
        <g transform="rotate(-4 260 210)">
          <rect x="74" y="98" width="376" height="234" rx="14" fill="url(#weave-indigo)" />
          <rect x="70" y="92" width="380" height="232" rx="14" fill="url(#weave-natural)" />
          <rect x="70" y="296" width="380" height="7" fill="url(#weave-indigo)" />
          <rect x="70" y="306" width="380" height="4" fill="url(#weave-madder)" />
          <path d="M70,150 C160,140 360,140 450,150" stroke="var(--color-charcoal-950)" stroke-opacity="0.12" stroke-width="5" fill="none" />
          <path d="M150,92 L136,324 M372,92 L386,324" stroke="var(--color-charcoal-950)" stroke-opacity="0.1" stroke-width="7" fill="none" />
          <rect x="70" y="92" width="380" height="232" rx="14" fill="url(#parcel-light)" />

          <!-- the thread -->
          <g fill="var(--color-madder-500)">
            <rect data-tie="v" x="276" y="84" width="4" height="248" rx="2" />
            <rect data-tie="h" x="62" y="214" width="396" height="4" rx="2" />
          </g>
          <g fill="none" stroke="var(--color-madder-500)" stroke-width="4" stroke-linecap="round">
            <path data-tie="loop-l" d="M278,216 C246,174 196,180 206,206 C214,228 254,224 278,216" />
            <path data-tie="loop-r" d="M278,216 C304,170 356,176 348,204 C340,228 300,226 278,216" />
            <path data-tie="tail-l" d="M278,216 C266,246 250,270 236,300" />
            <path data-tie="tail-r" d="M278,216 C292,248 304,272 322,296" />
          </g>
          <circle data-tie="knot" cx="278" cy="216" r="8" fill="var(--color-madder-600)" />
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .rw { display: inline-block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; vertical-align: top; }
  .rwi { display: inline-block; }
  .choice {
    display: grid;
    gap: 0.1rem;
    max-width: 30rem;
    padding: 1rem 1.2rem 0.6rem;
    border-left: 2px dashed var(--color-madder-500);
    background: color-mix(in srgb, var(--color-indigo-800) 70%, transparent);
  }
  .parcel-wrap { max-width: 40rem; justify-self: center; width: 100%; }
</style>
