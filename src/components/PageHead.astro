---
/**
 * Inner-page opening: an oversized headline that weaves in word by word,
 * a short intro, and a slot for the page's own picture. The thread from the
 * home page continues down the left edge.
 */
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  tone?: 'linen' | 'indigo';
}
const { eyebrow, title, intro, tone = 'linen' } = Astro.props;
const words = title.split(' ');
---
<section class:list={['relative overflow-hidden', tone === 'indigo' ? 'on-dark bg-indigo-900 text-linen-100' : 'bg-linen-100']} aria-labelledby="page-title">
  <div class="mx-auto grid max-w-[96rem] grid-cols-1 items-end gap-10 px-gutter pt-[calc(var(--spacing-header)+3.5rem)] pb-16 lg:grid-cols-12 lg:pb-24">
    <div class="relative z-[2] lg:col-span-7">
      <p class:list={['tag', tone === 'indigo' ? 'text-madder-300' : 'text-madder-700']}>{eyebrow}</p>
      <h1 id="page-title" class="mt-4 text-5xl font-light" aria-label={title}>
        {words.map((w, i) => <>{i > 0 && ' '}<span class="rw" aria-hidden="true"><span class="rwi" data-rword>{w}</span></span></>)}
      </h1>
      <p class:list={['mt-6 max-w-[44ch] text-lg', tone === 'indigo' ? 'text-linen-200' : 'text-linen-700']}>{intro}</p>
      <slot name="actions" />
    </div>
    <div class="relative lg:col-span-5">
      <slot />
    </div>
  </div>
</section>

<style>
  .rw { display: inline-block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; vertical-align: top; }
  .rwi { display: inline-block; }
</style>
