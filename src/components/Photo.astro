---
/**
 * A photo slot. With `src` it renders an optimised <Image>. Without it, it
 * shows a clearly labelled placeholder at the right size and shape, so the
 * real photo can be dropped in later (see `Photo` in src/content/site.ts).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label: string;
  alt: string;
  ratio?: number;
  src?: ImageMetadata;
  dark?: boolean;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}
const { label, alt, ratio = 4 / 5, src, dark = false, class: cls = '', sizes = '(min-width: 1024px) 40vw, 90vw', loading = 'lazy' } = Astro.props;
const ratioText = (() => {
  const known: Record<string, string> = { '0.8': '4:5', '1': '1:1', '1.5': '3:2', '1.778': '16:9', '0.667': '2:3', '1.333': '4:3' };
  return known[ratio.toFixed(3).replace(/0+$/, '').replace(/\.$/, '')] ?? `${ratio.toFixed(2)}:1`;
})();
---
{src ? (
  <Image src={src} alt={alt} sizes={sizes} widths={[480, 800, 1200, 1600]} loading={loading} class:list={['h-auto w-full object-cover', cls]} style={`aspect-ratio:${ratio}`} />
) : (
  <figure role="img" aria-label={`Photo placeholder: ${alt}`} class:list={['ph', { 'ph-dark': dark }, cls]} style={`aspect-ratio:${ratio}`}>
    <figcaption class="absolute inset-x-0 top-0 flex flex-col gap-1 p-3 pr-9 sm:p-4 sm:pr-10">
      <span class="tag opacity-80">Photo placeholder · {ratioText}</span>
      <span class="text-sm leading-snug font-semibold">{label}</span>
    </figcaption>
    <svg class="absolute top-3 right-3 h-5 w-5 opacity-60 sm:top-4 sm:right-4" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="6" width="18" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
      <circle cx="12" cy="12.5" r="3.2" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 6l1.5-2h5L16 6" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </figure>
)}
