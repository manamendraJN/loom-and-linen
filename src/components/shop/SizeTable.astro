---
import { sizeCare } from '../../content/site';
const { table } = sizeCare;
---
<div class="overflow-x-auto" data-lenis-prevent>
  <table class="w-full min-w-[22rem] border-collapse text-left text-sm">
    <caption class="tag pb-3 text-left text-linen-700">{table.note}</caption>
    <thead>
      <tr>{table.columns.map((c) => <th scope="col" class="border-b-2 border-charcoal-900 py-2 pr-3 font-semibold">{c}</th>)}</tr>
    </thead>
    <tbody>
      {table.rows.map((r) => (
        <tr class="border-b border-dashed border-linen-400">
          {r.map((cell, i) => (i === 0 ? <th scope="row" class="py-2.5 pr-3 font-mono font-medium">{cell}</th> : <td class="py-2.5 pr-3 font-mono text-linen-700">{cell}</td>))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
