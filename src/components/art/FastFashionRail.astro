---
/**
 * The "before" picture: a long rail of identical, flat, grey shirts.
 * Clearly an example of fast fashion (labelled in HeroScene), not our clothes.
 * viewBox 1800 × 200; the middle shirt (index 7, x = 900) has the loose thread.
 */
const slots = Array.from({ length: 15 }, (_, i) => i * 120 + 60);
const tee = 'M-18,34 C-10,42 10,42 18,34 L44,42 L58,70 L42,78 L36,68 L36,162 L-36,162 L-36,68 L-42,78 L-58,70 L-44,42 Z';
---
<svg viewBox="0 0 1800 200" class="block h-auto w-full overflow-visible" aria-hidden="true" focusable="false">
  <rect x="-200" y="8" width="2200" height="5" rx="2.5" fill="var(--color-steel-700)" />
  <rect x="-200" y="8" width="2200" height="1.5" fill="var(--color-steel-200)" opacity="0.7" />
  {slots.map((x) => (
    <g transform={`translate(${x} 0)`}>
      <path d="M0,34 L0,16 C0,10 6,6 10,10 C13,13 10,17 6,17" fill="none" stroke="var(--color-steel-700)" stroke-width="1.6" />
      <path d="M-40,44 L0,30 L40,44" fill="none" stroke="var(--color-steel-700)" stroke-width="1.6" />
      <path d={tee} fill="var(--color-steel-500)" />
      <path d="M-18,34 C-10,46 10,46 18,34" fill="none" stroke="var(--color-steel-700)" stroke-width="1.2" opacity="0.6" />
    </g>
  ))}
  <!-- the one loose thread -->
  <path data-loose d="M910,161 C914,178 900,190 906,206 C912,222 898,236 904,252" fill="none" stroke="var(--color-madder-500)" stroke-width="2.2" stroke-linecap="round" />
</svg>
