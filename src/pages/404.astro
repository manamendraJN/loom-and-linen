---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFound } from '../content/site';
---
<BaseLayout title={notFound.meta.title} description={notFound.meta.description}>
  <section class="relative grid min-h-[90svh] place-items-center overflow-hidden bg-linen-100 px-gutter pt-[var(--spacing-header)]">
    <svg class="absolute inset-x-0 top-1/2 h-40 w-full -translate-y-1/2" viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-20,90 C160,40 260,140 420,80 S700,30 820,96 C900,140 960,60 1010,70 C1060,80 1080,130 1060,150" fill="none" stroke="var(--color-madder-500)" stroke-width="2.4" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="relative max-w-[36rem] bg-linen-100/90 p-6 text-center">
      <p class="tag text-madder-700">404</p>
      <h1 class="mt-3 text-4xl font-light">{notFound.headline}</h1>
      <p class="mt-4 text-lg text-linen-700">{notFound.line}</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Back to the story</a>
        <a href="/shop" class="btn btn-outline">Shop the collection</a>
      </div>
    </div>
  </section>
</BaseLayout>
